		根据条件跳过(事件玩家.sym_barrier_shields[1] == 空, 1);
		移除玩家的生命池(事件玩家.sym_barrier_shields[1]);
		为玩家添加生命池(事件玩家, 护盾, 1000, 真, 假);
		事件玩家.sym_barrier_shields[1] = 最后创建的生命池;
		等待直到 (!事件玩家.sym_barrier_shields[0], 12.500);
		移除玩家的生命池(事件玩家.sym_barrier_shields[1]);
		事件玩家.sym_barrier_shields[1] = 空;
	}
}

规则("[Tracer]: Blink explosion target")
{
	事件
	{
		玩家受到伤害;
		队伍1;
		全部;
	}

	条件
	{
		事件技能 == 按钮(终极技能);
		(所用英雄(攻击方) == 英雄(猎空)) == 真;
		事件伤害 >= 70;
		数量(范围内玩家(事件玩家, 25, 所在队伍(事件玩家), 表面)) != 0;
	}

	动作
	{
		伤害(事件玩家, 事件玩家.tracer_buff[1], 取整(最大生命值(事件玩家) * 0.100, 上));
		等待(0.500, 无视条件);
		范围内玩家(事件玩家, 25, 所在队伍(事件玩家), 表面).tracer_buff[0] = 真;
		范围内玩家(事件玩家, 25, 所在队伍(事件玩家), 表面).tracer_buff[1] = 攻击方;
	}
}

规则("[Tracer]: Blink explosion")
{
	事件
	{
		持续 - 每名玩家;
		队伍1;
		全部;
	}

	条件
	{
		事件玩家.tracer_buff[0] == 真;
		存活(事件玩家) == 真;
	}

	动作
	{
		播放效果(所有玩家(所有队伍), D.Va自毁爆炸效果, 颜色(队伍1), 事件玩家, 200);
		播放效果(所有玩家(所有队伍), D.Va自毁爆炸声音, 颜色(白色), 事件玩家, 200);
		伤害(事件玩家, 事件玩家.tracer_buff[1], 取整(最大生命值(事件玩家) * 0.080, 上));
		等待(0.160, 无视条件);
		事件玩家.tracer_buff[0] = 假;
		事件玩家.tracer_buff[1] = 空;
	}
}

规则("[widowmaker/init.opy]: Initialize Widowmaker ammo")
{
	事件
	{
		持续 - 每名玩家;
		队伍2;
		黑百合;
	}

	条件
	{
		弹药(事件玩家, 0) > 5;
	}

	动作
	{
		禁用 设置最大弹药(事件玩家, 0, 1);
		设置弹药(事件玩家, 0, 5);
	}
}

规则("[widowmaker.opy]: Infra-Sight headshot")
{
	事件
	{
		玩家造成伤害;
		队伍2;
		黑百合;
	}

	条件
	{
		事件暴击 == 真;
		正在使用辅助武器(事件玩家) == 真;
		正在使用主要武器(事件玩家) == 真;
		事件技能 == 按钮(主要攻击模式);
		事件伤害 >= 200;
	}

	动作
	{
		伤害(被攻击方, 攻击方, 最大生命值(被攻击方) * 0.500);
	}
}

规则("【布丽吉塔】恢复包选中目标")
{
	事件
	{
		持续 - 每名玩家;
		队伍2;
		布丽吉塔;
	}

	条件
	{
		正在使用技能 2(事件玩家) == 真;
		相距距离(事件玩家, 距离准星最近的玩家(事件玩家, 所在队伍(事件玩家))) <= 20.250;
	}

	动作
	{
		首个(已排序的数组(所有存活玩家(所在队伍(事件玩家)), 矢量间夹角(面朝方向(事件玩家), 方向(所选位置(事件玩家), 所选位置(当前数组元素))))).brig_repair_pack[0] = 真;
	}
}

规则("【布丽吉塔】恢复包提供护甲")
{
	事件
	{
		持续 - 每名玩家;
		队伍2;
		全部;
	}

	条件
	{
		所用英雄(事件玩家) != 英雄(布丽吉塔);
		(存活(事件玩家) && 事件玩家.brig_repair_pack[0]) == 真;
	}

	动作
	{
		事件玩家.brig_repair_pack[0] = 假;
		根据条件跳过(事件玩家.brig_repair_pack[1] == 空, 1);
		移除玩家的生命池(事件玩家.brig_repair_pack[1]);
		为玩家添加生命池(事件玩家, 护甲, 150, 假, 假);
		小字体信息(事件玩家, 自定义字符串("  {0} 获得来自 {1} 的护甲", 技能图标字符串(英雄(布丽吉塔), 按钮(技能2)), 英雄(布丽吉塔)));
		事件玩家.brig_repair_pack[1] = 最后创建的生命池;
	}
}

规则("[Brigitte]: Rally provides permanent armor to self")
{
	事件
	{
		持续 - 每名玩家;
		队伍2;
		全部;
	}

	条件
	{
		数量(事件玩家.brig_rally_armor_id) == 13;
	}

	动作
	{
		等待直到 (!正在使用终极技能(选择英雄的玩家(英雄(布丽吉塔), 所在队伍(事件玩家))) && 事件玩家.brig_rally_armor_id != 空数组, 30);
		等待(4, 无视条件);
		移除玩家的生命池(首个(事件玩家.brig_rally_armor_id));
		禁用 事件玩家.brig_rally_armor_id = 空数组;
		修改玩家变量(事件玩家, brig_rally_armor_id, 根据值从数组中移除, 首个(事件玩家.brig_rally_armor_id));
		根据条件循环(数量(事件玩家.brig_rally_armor_id) != 0);
	}
}

规则("[Brigitte]Rally provides permanent armor to self")
{
	事件
	{
		持续 - 每名玩家;
		队伍2;
		布丽吉塔;
	}

	条件
	{
		正在使用终极技能(事件玩家) == 真;
		数量(事件玩家.brig_rally_armor_id) < 13;
	}

	动作
	{
		为玩家添加生命池(所有存活玩家(所在队伍(事件玩家)), 护甲, 25, 假, 假);
		修改玩家变量(所有存活玩家(所在队伍(事件玩家)), brig_rally_armor_id, 添加至数组, 最后创建的生命池);
		等待(0.500, 无视条件);
		如条件为“真”则循环;
	}
}

规则("[Lucio]: Crossfade dmg")
{
