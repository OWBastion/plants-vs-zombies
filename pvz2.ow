规则("[Zenyatta] Sub Knockback")
{
	事件
	{
		子程序;
		knockBack;
	}

	动作
	{
		等待(0.016, 无视条件);
		施加推力(事件玩家, 事件玩家.knockback_direction, 22.500, 至地图, 取消相反运动);
		施加推力(事件玩家, 上, 22.500 * 0.300, 至地图, 取消相反运动);
	}
}

规则("[Zenyatta] Snap Kick (enemy)")
{
	事件
	{
		玩家受到伤害;
		队伍1;
		全部;
	}

	条件
	{
		事件技能 == 按钮(近身攻击);
		(所用英雄(攻击方) == 英雄(禅雅塔)) == 真;
	}

	动作
	{
		事件玩家.knockback_direction = 与此角度的相对方向(水平朝向角度(攻击方), -10);
		开始限制阈值(事件玩家, 0, 0, 0, 0, 0, 0.500);
		调用子程序(knockBack);
		等待(0.016, 无视条件);
		停止限制阈值(事件玩家);
	}
}

