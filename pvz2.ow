			全局.Brain_Points = 数组(矢量(81.030, 130.030, -84.940));
		Else;
		End;
		创建效果(所有玩家(队伍2), 球体, 颜色(黄色), 首个(全局.Bot_Respawn_Points), 0.300, 可见，位置和半径);
		创建效果(所有玩家(队伍2), 球体, 颜色(黄色), 全局.Bot_Respawn_Points[1], 0.300, 可见，位置和半径);
		创建效果(所有玩家(队伍2), 球体, 颜色(黄色), 全局.Bot_Respawn_Points[2], 0.300, 可见，位置和半径);
		创建效果(所有玩家(队伍2), 球体, 颜色(黄色), 全局.Bot_Respawn_Points[3], 0.300, 可见，位置和半径);
		创建效果(所有玩家(队伍2), 光柱, 颜色(白色), 首个(全局.Brain_Points), 1, 可见，位置和半径);
	}
}

规则("Player Resurrect - Respawn at Brain Points")
{
	事件
	{
		玩家阵亡;
		队伍2;
		全部;
	}

	条件
	{
		游戏正在进行中 == 真;
		禁用 全局.Under_Attack != 真;
		存活(事件玩家) != 真;
		禁用 (全局.Current_Round == 4 || 全局.Current_Round == 6 || 全局.Current_Round == 8 || 全局.Current_Round == 10) == 真;
	}

	动作
	{
		禁用 等待直到 (全局.Current_Round == 4 || 全局.Current_Round == 6 || 全局.Current_Round == 8 || 全局.Current_Round == 10, 999999986991104.000);
		传送(事件玩家, 首个(全局.Brain_Points));
		等待直到 (!全局.Under_Attack && (全局.Current_Round == 4 || 全局.Current_Round == 6 || 全局.Current_Round == 8 || 全局.Current_Round == 10) == 真,
			999999986991104.000);
		复活(事件玩家);
	}
}

规则("Hud text")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		创建HUD文本(所有玩家(所有队伍), 空, 自定义字符串("植物大战僵尸 PvE（BMAMW）"), 空, 右边, 0, 颜色(白色), 颜色(白色), 空, 可见和字符串, 默认可见度);
		创建HUD文本(所有玩家(所有队伍), 空, 自定义字符串("选择植物并保护你的脑子（白色光柱）"), 空, 右边, 0, 颜色(白色), 颜色(白色), 空, 可见和字符串, 默认可见度);
		创建HUD文本(所有玩家(所有队伍), 空, 自定义字符串("准备时间结束后将不能移动"), 空, 右边, 0, 颜色(白色), 颜色(白色), 空, 可见和字符串, 默认可见度);
	}
}

规则("Players - HUD - Show round")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		全局.Current_Round < 全局.Config_Total_Round;
	}

	动作
	{
		创建HUD文本(所有玩家(队伍2), 空, 自定义字符串("\n\r\n\r\n\r\n\r\n\r"), 自定义字符串("第 {0}/{1} 波", 全局.Current_Round, 全局.Config_Total_Round), 顶部, -3, 颜色(
			白色), 颜色(白色), 颜色(白色), 可见和字符串, 默认可见度);
		创建HUD文本(所有玩家(队伍2), 空, 空, 全局.Under_Attack == 假 ? 自定义字符串("准备时间 {0}s", 取整(全局.Round_Lead_Time, 上)) : 自定义字符串("当前波次 {0}s", 取整(
			全局.Round_Attack_Time, 上)), 顶部, -2, 颜色(白色), 颜色(白色), 颜色(白色), 可见和字符串, 默认可见度);
	}
}

规则("Players - Round Lead Time Start")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		(正在集结英雄 || 游戏正在进行中) == 真;
		禁用 游戏正在进行中 == 真;
		全局.Current_Round < 全局.Config_Total_Round;
		全局.Under_Attack == 假;
	}

	动作
	{
		等待直到 (!正在集结英雄 && 游戏正在进行中, 999999986991104.000);
		设置状态(所有玩家(队伍1), 空, 无敌, 999999986991104.000);
		持续追踪全局变量(Round_Lead_Time, 0, 全局.Config_Round_Lead_Time, 无);
		大字体信息(所有玩家(所有队伍), 自定义字符串("第 {0} 波即将开始", 全局.Current_Round + 1));
	}
}

规则("Players - Round Lead Time End")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		游戏正在进行中 == 真;
		全局.Current_Round < 全局.Config_Total_Round;
		全局.Under_Attack == 假;
	}

	动作
	{
		等待直到 (全局.Round_Lead_Time == 0, 全局.Config_Round_Lead_Time);
		移除所有机器人;
		全局.Under_Attack = 真;
		全局.Current_Round += 1;
		全局.Round_Attack_Time = 全局.Config_Round_Attack_Time;
		全局.Round_Lead_Time = 0;
	}
}

规则("Players - Round Attack Start")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		游戏正在进行中 == 真;
		全局.Current_Round < 全局.Config_Total_Round;
		全局.Under_Attack == 真;
	}

	动作
	{
		清除状态(所有玩家(队伍1), 无敌);
		大字体信息(所有玩家(所有队伍), 自定义字符串("第 {0} 波进攻", 全局.Current_Round));
		持续追踪全局变量(Round_Attack_Time, 0, 全局.Config_Round_Attack_Time, 无);
	}
}

规则("Players - Round Attack End")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		游戏正在进行中 == 真;
		全局.Current_Round < 全局.Config_Total_Round;
		全局.Under_Attack == 真;
	}

	动作
	{
		等待直到 (全局.Round_Attack_Time == 0, 全局.Config_Round_Attack_Time);
		等待直到 (存活玩家数量(队伍1) == 数量(已过滤的数组(所有存活玩家(队伍1), 相距距离(所选位置(当前数组元素), 所选位置(重生点(队伍1))) <= 55)) || 数量(已过滤的数组(所有存活玩家(队伍1), 相距距离(所选位置(当前数组元素),
			所选位置(首个(全局.Brain_Points))) >= 45)), 999999986991104.000);
		全局.Under_Attack = 假;
		全局.Round_Lead_Time = 全局.Config_Round_Lead_Time;
	}
}

规则("[utilities/Player]: Set Third Person")
{
	事件
	{
		子程序;
