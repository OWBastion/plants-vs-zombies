规则("//AI Target")
{
	事件
	{
		子程序;
		AITarget;
	}

	动作
	{
		If(事件玩家.BotTarget == 空 || 死亡(事件玩家.BotTarget));
			事件玩家.TTK = 0;
			事件玩家.BotTarget = 数组随机取值(已过滤的数组(所有存活玩家(对方队伍(所在队伍(事件玩家))), 在视线内(眼睛位置(事件玩家), 当前数组元素, 屏障不会阻挡视线) && 已重生(当前数组元素) && Y方向分量(所选位置(当前数组元素))
				- Y方向分量(所选位置(事件玩家)) <= 5.500));
			追踪玩家变量频率(事件玩家, TTK, 6, 1, 速率及最终值);
		Else If(事件玩家.TTK == 6);
			事件玩家.TTK = 0;
			事件玩家.BotTarget = 数组随机取值(已过滤的数组(所有存活玩家(对方队伍(所在队伍(事件玩家))), 在视线内(眼睛位置(事件玩家), 当前数组元素, 屏障不会阻挡视线) && 已重生(当前数组元素) && Y方向分量(所选位置(当前数组元素))
				- Y方向分量(所选位置(事件玩家)) <= 5.500));
			追踪玩家变量频率(事件玩家, TTK, 6, 1, 速率及最终值);
		End;
	}
}

规则("//AI Move")
{
	事件
	{
		子程序;
		AIMove;
	}

	动作
	{
		If(事件玩家.BotTarget == 空 || 相距距离(事件玩家, 所选位置(首个(全局.Brain_Points))) <= 相距距离(事件玩家, 事件玩家.BotTarget));
			开始朝向(事件玩家, 方向(眼睛位置(事件玩家), 所选位置(首个(全局.Brain_Points))), 270, 至地图, 方向及角速率);
			开始定向阈值(事件玩家, 方向(事件玩家, 所选位置(首个(全局.Brain_Points))), 1, 至地图, 替换现有阈值, 方向和幅度);
			If(水平速度(事件玩家) <= 1 && 相距距离(事件玩家, 所选位置(首个(全局.Brain_Points))) >= 15 && 相距距离(事件玩家, 距离最近的玩家(事件玩家, 队伍1)) >= 15);
				禁用 If(栏位(事件玩家) != 2);
				击杀(事件玩家, 空);
				禁用 Else;
				禁用 传送(事件玩家, 距离最近的玩家(事件玩家, 队伍2));
				禁用 End;
			End;
		Else;
			开始朝向(事件玩家, 方向(眼睛位置(事件玩家), 眼睛位置(事件玩家.BotTarget) - 矢量(0, 0.300, 0)), 270, 至地图, 方向及角速率);
			开始定向阈值(事件玩家, 方向(事件玩家, 事件玩家.BotTarget), 1, 至地图, 替换现有阈值, 方向和幅度);
		End;
	}
}

规则("//AI Move")
{
	事件
	{
