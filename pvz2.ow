规则("[Cassidy.opy]: Revert sniper damage falloff")
{
	事件
	{
		玩家造成伤害;
		队伍2;
		卡西迪;
	}

	条件
	{
		事件技能 == 按钮(主要攻击模式);
		相距距离(眼睛位置(攻击方), 被攻击方) >= 25.100;
	}

	动作
	{
		事件玩家.scoped_shot_distance = 相距距离(眼睛位置(攻击方), 被攻击方);
		"原OW2衰减计算（25-35米 70%衰减）"
		事件玩家.ow2_scoped_damage_falloff_scalar = 1 - (事件玩家.scoped_shot_distance - 25) / 10 * 0.700 + (1 - (事件玩家.scoped_shot_distance - 25)
			/ 10);
		If(事件玩家.ow2_scoped_damage_falloff_scalar > 1);
			事件玩家.ow2_scoped_damage_falloff_scalar = 1;
		"Min damage scalar"
		Else If(事件玩家.ow2_scoped_damage_falloff_scalar < 0.300);
			事件玩家.ow2_scoped_damage_falloff_scalar = 0.300;
		End;
		事件玩家.scoped_damage_base = 事件伤害 / 事件玩家.ow2_scoped_damage_falloff_scalar;
		事件玩家.ow1_scoped_damage_falloff_scalar = 1 - (事件玩家.scoped_shot_distance - 25) / 25 * 0.300;
		"Cap min/max scalar\n Max damage scalar"
		If(事件玩家.ow1_scoped_damage_falloff_scalar < 0.700);
			事件玩家.ow1_scoped_damage_falloff_scalar = 0.700;
		End;
		If(事件玩家.scoped_shot_distance > 50);
			事件玩家.ow1_scoped_damage_falloff_scalar = 0.700;
		End;
		事件玩家.expected_scoped_damage = 事件玩家.scoped_damage_base * 事件玩家.ow1_scoped_damage_falloff_scalar;
		伤害(被攻击方, 攻击方, 取整(事件玩家.expected_scoped_damage - 事件伤害, 上));
	}
}

