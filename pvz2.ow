		106: scoped_shot_distance
		107: scoped_damage_base
		108: ow2_scoped_damage_falloff_scalar
		109: ow1_scoped_damage_falloff_scalar
		110: expected_scoped_damage
}

子程序
{
	1: AITarget
	2: AIMove
	3: setThirdPerson
	4: setPlayerHeros
	5: knockBack
}

规则("Copyright (c) 2025 他又（aka Teakowa）")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		禁用查看器录制;
		全局.Tank_Heros = 所有重装英雄;
		全局.Damage_Heros = 所有输出英雄;
		全局.Support_Heros = 所有支援英雄;
		修改全局变量(Tank_Heros, 根据值从数组中移除, 英雄(破坏球));
		修改全局变量(Damage_Heros, 根据值从数组中移除, 英雄(探奇));
	}
}

规则("Initialize global variables")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		全局.Debug = 地图工坊设置开关(自定义字符串("Debug"), 自定义字符串("Debug开关"), 假, 100);
		全局.Config_Total_Round = 地图工坊设置整数(自定义字符串("模式"), 自定义字符串("最大攻击波次"), 12, 4, 36, 12);
		全局.Difficult = 地图工坊设置组合(自定义字符串("模式"), 自定义字符串("难度"), 0, 数组(自定义字符串("简单： AI 逐渐生成至上限"), 自定义字符串("困难：AI 在第6波达到生成上限"), 自定义字符串(
			"专家：AI 在第4波达到生成上限"), 自定义字符串("苦难：AI 在第1波达到生成上限")), 0);
		全局.NumberOfZombies = 地图工坊设置整数(自定义字符串("模式"), 自定义字符串("AI 上限"), 13, 4, 16, 15);
		全局.Config_Round_Attack_Time = 地图工坊设置整数(自定义字符串("模式"), 自定义字符串("攻击波持续时间"), 300, 30, 600, 13);
		全局.Config_Round_Lead_Time = 地图工坊设置整数(自定义字符串("模式"), 自定义字符串("攻击波间隔时间"), 30, 15, 60, 14);
		全局.Round_Lead_Time = 全局.Config_Round_Lead_Time;
		全局.Round_Attack_Time = 全局.Config_Round_Attack_Time;
		全局.ANTI_CRASH_ACTIVATE_PERCENT = 地图工坊设置整数(自定义字符串("Anti Crash"), 自定义字符串("激活阈值"), 230, 0, 250, 0);
		全局.ANTI_CRASH_HOLD_TIME = 地图工坊设置实数(自定义字符串("Anti Crash"), 自定义字符串("激活持续时间"), 8, 0, 20, 1);
		全局.ANTI_CRASH_DEACTIVATE_PERCENT = 地图工坊设置整数(自定义字符串("Anti Crash"), 自定义字符串("停用阈值"), 180, 0, 250, 2);
		全局.Hero_BAN[0] = 地图工坊设置整数(自定义字符串("英雄池"), 自定义字符串("随机英雄池：重装"), 4, 1, 6, 11);
		全局.Hero_BAN[1] = 地图工坊设置整数(自定义字符串("英雄池"), 自定义字符串("随机英雄池：输出"), 8, 1, 12, 12);
		全局.Hero_BAN[2] = 地图工坊设置整数(自定义字符串("英雄池"), 自定义字符串("随机英雄池：支援"), 4, 1, 6, 13);
	}
}

规则("[Anti Crash]: Activate anti crash")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		服务器负载 > 全局.ANTI_CRASH_ACTIVATE_PERCENT;
	}

	动作
	{
		等待(全局.ANTI_CRASH_HOLD_TIME, 当为“假”时中止);
		小字体信息(所有玩家(所有队伍), 自定义字符串("  服务器过载  "));
		设置慢动作(1);
		等待(0.500, 无视条件);
		等待直到 (服务器负载 < 全局.ANTI_CRASH_DEACTIVATE_PERCENT, 999999986991104.000);
		设置慢动作(100);
	}
}

规则("[Global]Setup Blacklist")
