	}

	动作
	{
		已过滤的数组(所有存活玩家(对方队伍(所在队伍(事件玩家))), 相距距离(事件玩家, 当前数组元素) <= 12.500 && !当前数组元素.lucio_crossfade_dmg[0]).lucio_crossfade_dmg[0] = 真;
		已过滤的数组(所有存活玩家(对方队伍(所在队伍(事件玩家))), 相距距离(事件玩家, 当前数组元素) <= 12.500).lucio_crossfade_dmg[1] = 事件玩家;
		等待(1, 无视条件);
		如条件为“真”则循环;
	}
}

规则("[Lucio]: Crossfade dmg")
{
