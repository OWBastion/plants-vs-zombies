规则("[Player]: Override allowed heroes list when player joins lobby")
{
	事件
	{
		玩家加入比赛;
		队伍2;
		全部;
	}

	动作
	{
		If(全局.Debug);
			设置玩家可选的英雄(事件玩家, 全部英雄);
		Else;
			调用子程序(setPlayerHeros);
		End;
	}
}

规则("[Player]: set heros")
{
	事件
	{
		子程序;
		setPlayerHeros;
	}

	动作
	{
		事件玩家.heros = 数组(所用英雄(事件玩家));
		等待(0.160, 无视条件);
		事件玩家.heros = 数组(数组分割(随机数组(全局.Tank_Heros), 0, 全局.Hero_BAN[0]), 数组分割(随机数组(全局.Damage_Heros), 0, 全局.Hero_BAN[1]), 数组分割(随机数组(
			全局.Support_Heros), 0, 全局.Hero_BAN[2]));
		设置玩家可选的英雄(事件玩家, 事件玩家.heros);
	}
}

规则("Disable Scoring, Intro hud, Arena Locations, Spawn Loc, Spawn detect")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		游戏正在进行中 == 真;
		全局.Current_Round >= 2;
	}

	动作
	{
		等待(5, 无视条件);
		设置比赛时间(900);
	}
}

规则("Disable Scoring, Intro hud, Arena Locations, Spawn Loc, Spawn detect")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		游戏正在进行中 == 真;
		全局.Under_Attack == 真;
		全局.Current_Round == 全局.Config_Total_Round;
	}

	动作
	{
		等待(1, 无视条件);
		设置比赛时间(全局.Config_Round_Attack_Time + 全局.Config_Round_Lead_Time);
	}
}

规则("Disable Scoring, Intro hud, Arena Locations, Spawn Loc, Spawn detect")
{
	事件
	{
		持续 - 全局;
	}

	动作
	{
		关闭游戏预设复生模式(所有玩家(队伍1));
		关闭游戏预设完成条件;
		"Arena locations"
		If(当前地图 == 地图(阿育陀耶));
			全局.Bot_Respawn_Points = 数组(矢量(16, 1, 25), 矢量(-6.500, 5, 25), 矢量(34.520, 6, 38.100), 矢量(16, 6, 23));
			全局.Brain_Points = 数组(矢量(16, 1.190, 52), 矢量(24, 1, 56), 矢量(-6, 3, 54));
		Else If(当前地图 == 地图(漓江塔夜市));
			全局.Bot_Respawn_Points = 数组(矢量(32, 0, -21.750), 矢量(42.350, 6, -46), 矢量(30, 6, -14.180), 矢量(40, 2, -41.800));
			全局.Brain_Points = 数组(矢量(88.500, 4.500, -25.500));
		Else If(当前地图 == 地图(漓江塔控制中心));
			全局.Bot_Respawn_Points = 数组(矢量(31.210, 267, 312), 矢量(20, 270, 347.290), 矢量(24, 267, 327.170));
			全局.Brain_Points = 数组(矢量(67.710, 267.450, 349.430));
		Else If(当前地图 == 地图(漓江塔控制中心));
			全局.Bot_Respawn_Points = 数组(矢量(31.210, 267, 312), 矢量(20, 270, 347.290), 矢量(24, 267, 327.170));
			全局.Brain_Points = 数组(矢量(67.710, 267.450, 349.430));
		Else If(当前地图 == 地图(伊利奥斯灯塔));
			全局.Bot_Respawn_Points = 数组(矢量(355, -24.660, 1.660), 矢量(324, -24.700, -0.040), 矢量(332.120, -20.740, 11.470), 矢量(336.380, -16.260,
				8.630));
			全局.Brain_Points = 数组(矢量(320, -23.970, 46.250));
		Else If(当前地图 == 地图(伊利奥斯废墟));
			全局.Bot_Respawn_Points = 数组(矢量(-28.860, 58.370, -156.100), 矢量(-18.580, 59.390, -143.900), 矢量(-22.150, 58.370, -170.630), 矢量(-26.530,
				67.620, -179.830));
			全局.Brain_Points = 数组(矢量(-80.120, 63.040, -160.040));
		Else If(当前地图 == 地图(伊利奥斯深井));
			全局.Bot_Respawn_Points = 数组(矢量(-185.280, 5.030, -42.680), 矢量(-186.790, 3.780, -56.120), 矢量(-163.670, 4.860, -38.010));
			全局.Brain_Points = 数组(矢量(-148.320, -3.410, -93.480));
		Else If(当前地图 == 地图(尼泊尔村庄));
			全局.Bot_Respawn_Points = 数组(矢量(-169.790, -95.240, -33.050), 矢量(-199.720, -97.330, -54.500), 矢量(-163.220, -89.210, -28.770));
			全局.Brain_Points = 数组(矢量(-157.450, -97.520, -80.770));
		Else If(当前地图 == 地图(尼泊尔圣坛));
			全局.Bot_Respawn_Points = 数组(矢量(-47.220, 19, -48.040), 矢量(-23.700, 22, -57.430), 矢量(-56.610, 15, -61.610));
			全局.Brain_Points = 数组(矢量(-43.180, 16.380, -88.260));
