规则("[ai]: Create AI Bot")
{
	事件
	{
		持续 - 全局;
	}

	条件
	{
		玩家数量(队伍1) < 全局.NumberOfZombies;
	}

	动作
	{
		生成机器人(英雄(布丽吉塔), 队伍1, -1, 所选位置(首个(全局.Bot_Respawn_Points)), 首个(全局.Brain_Points));
		While(玩家数量(队伍1) < 全局.NumberOfZombies);
			等待(0.160, 无视条件);
			禁用 生成机器人(数组随机取值(已过滤的数组(全局.Zombie_Heros, 英雄数量(当前数组元素, 队伍1) == 0)), 队伍1, -1, 所选位置(首个(全局.Bot_Respawn_Points)), 矢量(0, 0, 0));
			生成机器人(已过滤的数组(全局.Zombie_Heros, 英雄数量(当前数组元素, 队伍1) <= 3), 队伍1, -1, 数组随机取值(全局.Bot_Respawn_Points), 首个(全局.Brain_Points));
		End;
		设置移动速度(所有玩家(队伍1), 90);
	}
}

规则("[ai]: Remove AI Bot")
{
	事件
	{
		玩家阵亡;
		队伍1;
		全部;
	}

	条件
	{
		全局.Under_Attack == 真;
		是否是机器人(事件玩家) == 真;
	}

	动作
	{
		等待(全局.Current_Round == 全局.Config_Total_Round ? 1 : 2, 无视条件);
		传送(事件玩家, 数组随机取值(全局.Bot_Respawn_Points));
		禁用 传送(事件玩家, 重生点(队伍1));
		禁用 移除机器人(所在队伍(事件玩家), 栏位(事件玩家));
		禁用 设置最大复生时间(事件玩家, 9999);
		等待(全局.Current_Round == 全局.Config_Total_Round ? 3 : 6, 无视条件);
		禁用 根据条件跳过(全局.Round_Attack_Time == 0, 1);
		复生(事件玩家);
	}
}

